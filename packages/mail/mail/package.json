{
  "name": "@deepseek-ai/dsh-mail",
  "description": "Outbound mail seam for DeepSeek Harness: assemble a letter, guard it, and hand it to a console or SMTP transport",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mail/mail"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "bin.js",
    "lib/bin.js"
  ],
  "scripts": {
    "test": "vitest run",
    "send": "tsx src/cli.ts send"
  },
  "license": "MIT",
  "bin": {
    "mail-send": "./bin.js",
    "mail-preview": "./bin.js",
    "mail-status": "./bin.js",
    "mail-accept": "./bin.js",
    "mail-mcp": "./bin.js"
  }
}
